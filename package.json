{
  "name": "scamshield-extension",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Extension de navegador de ScamShield: estima el riesgo de una publicacion leyendo el DOM ya renderizado, sin scraping.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "build:all": "pnpm build:chrome && pnpm build:firefox && pnpm build:safari",
    "zip:chrome": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "safari:convert": "bash scripts/safari-convert.sh",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
